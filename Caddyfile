# Chipsound — Caddy config. Listens on $PORT (defaults to :80 locally; the HF
# Space wrapper image sets PORT=7860). Swap for your domain to get auto-HTTPS.
:{$PORT:80} {
	root * /usr/share/caddy

	# Fallback compression for anything not pre-compressed at build time.
	encode {
		zstd
		gzip
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@assets path /js/* /css/* /images/*
	header @assets Cache-Control "public, max-age=86400"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Mod Archive XML API proxy for the Library's "Mod Archive" tab. The API
	# (https://modarchive.org/index.php?xml-api) needs a per-application key,
	# read here from the MODARCHIVE_API_KEY environment variable so it never
	# reaches the browser. Only read-only request types are forwarded. Leave the
	# variable unset (or delete the block) to disable the tab — it degrades
	# gracefully and explains what's missing.
	@modarchive {
		path /api/modarchive
		query request=search request=chart request=view_by_moduleid request=view_by_list request=view_by_rating_reviews request=view_by_rating_comments
	}
	handle @modarchive {
		rewrite * /xml-tools.php?key={env.MODARCHIVE_API_KEY}&{http.request.uri.query}
		reverse_proxy https://api.modarchive.org {
			header_up Host api.modarchive.org
			header_up -Cookie
			header_down -Set-Cookie
			header_down Cache-Control "public, max-age=600"
		}
	}
	@modarchive_random {
		path /api/modarchive
		query request=random
	}
	handle @modarchive_random {
		rewrite * /xml-tools.php?key={env.MODARCHIVE_API_KEY}&{http.request.uri.query}
		reverse_proxy https://api.modarchive.org {
			header_up Host api.modarchive.org
			header_up -Cookie
			header_down -Set-Cookie
			header_down Cache-Control "no-store"
		}
	}

	# `precompressed` serves the build-time .br / .zst sibling at zero runtime
	# CPU cost. `browse` is required for runtime theme + viz directory
	# discovery (src/js/themes.js, src/js/viz-engine.js parse the HTML listing).
	file_server {
		precompressed br zstd gzip
		browse
	}
}
